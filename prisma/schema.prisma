generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Product {
  id         Int         @id @default(autoincrement())
  name       String
  price      Float
  costPrice  Float
  category   String
  image      String      @db.LongText
  hoverImage String?     @db.LongText
  isNew      Boolean     @default(false)
  stock      Int         @default(0)
  orderItems OrderItem[]
}

model Order {
  id      Int         @id @default(autoincrement())
  date    DateTime    @default(now())
  total   Float
  prenom  String
  nom     String
  adresse String
  cp      String
  ville   String
  items   OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Float
  costPrice Float
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId], map: "OrderItem_orderId_fkey")
  @@index([productId], map: "OrderItem_productId_fkey")
}

model DailyVisit {
  id    Int      @id @default(autoincrement())
  date  DateTime @unique
  count Int      @default(0)
}

model MusicTrack {
  id       Int     @id @default(autoincrement())
  title    String
  url      String  @db.LongText
  isActive Boolean @default(false)
}

model analytics {
  id          Int       @id @default(autoincrement())
  event_type  String    @db.VarChar(50)
  product_ref String?   @db.VarChar(50)
  timestamp   DateTime? @default(now()) @db.Timestamp(0)
}

model order_items {
  id         Int    @id @default(autoincrement())
  order_id   Int
  product_id String @db.VarChar(50)
  quantity   Int
  orders     orders @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_order_items")

  @@index([order_id], map: "fk_order_items_idx")
}

model orders {
  id            Int           @id @default(autoincrement())
  customer_name String        @db.VarChar(255)
  phone         String        @db.VarChar(50)
  address       String        @db.Text
  total_amount  Int
  status        String?       @default("Nouvelle") @db.VarChar(50)
  created_at    DateTime?     @default(now()) @db.Timestamp(0)
  order_items   order_items[]
}

model product_thumbnails {
  id         Int       @id @default(autoincrement())
  product_id String?   @db.VarChar(50)
  url        String?   @db.VarChar(255)
  products   products? @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_product_thumbnails")

  @@index([product_id], map: "fk_product_thumbnails_idx")
}

model products {
  id                 String               @id @db.VarChar(50)
  ref                String               @db.VarChar(50)
  name               String               @db.VarChar(255)
  price              Int
  gender             String               @db.VarChar(20)
  image              String               @db.VarChar(255)
  groupId            String?              @db.VarChar(50)
  product_thumbnails product_thumbnails[]
}

model Newsletter {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

model PromoCode {
  id              Int      @id @default(autoincrement())
  code            String   @unique
  discountPercent Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model Review {
  id         Int      @id @default(autoincrement())
  productId  String   @db.VarChar(50)
  authorName String
  rating     Int
  comment    String   @db.Text
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId])
}

model SiteSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @db.Text
}
